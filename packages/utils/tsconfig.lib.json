/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/utils",
        "rootDir": "src",
        "target": "es2020",
        "module": "CommonJS",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "sourceMap": true,
        "strict": true,
        "paths": {
            "@ai-table/utils": [
                "./src/public-api"
            ],
            "@ai-table/utils/*": [
                "./src/*"
            ]
        },
        "lib": [
            "dom",
            "ES2022"
        ]
    },
    "exclude": []
}
